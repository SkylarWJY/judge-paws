# --- Required for real AI verdicts ---
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Waitlist -> beehiiv (optional) ---
# If both are set, /api/waitlist pushes emails straight into your beehiiv
# publication. If unset, emails fall back to data/waitlist.json (local dev).
# API key: beehiiv dashboard -> Settings -> API. Publication id starts with "pub_".
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- Optional ---
# PORT=4319
