# --- Required for real AI verdicts ---
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Payments: Stripe (Judge Paws+ subscription) ---
# Start in TEST mode (no account verification needed). Create a recurring
# product/price ($2.99/mo) in the Stripe dashboard and paste the price id.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_MONTHLY=price_...
# Optional yearly plan:
STRIPE_PRICE_YEARLY=
# From `stripe listen` (local) or the dashboard webhook endpoint:
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Waitlist -> beehiiv (optional) ---
# If both are set, /api/waitlist pushes emails straight into your beehiiv
# publication. If unset, emails fall back to data/waitlist.json (local dev).
# API key: beehiiv dashboard -> Settings -> API. Publication id starts with "pub_".
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- Optional ---
# PORT=4319

# --- Free-tier verdicts: Gemini Flash-Lite (~$0.0005/verdict) ---
# Subscribers get Claude Opus; free users get Gemini when this is set.
# Get a key at https://aistudio.google.com (needs prepay credits or free-tier project).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
